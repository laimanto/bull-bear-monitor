# Whitelist: ONLY the Bull-Bear Monitor production pipeline is published.
# Research scripts, experiment docs, private notes and scratch data stay local.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/.github

!/scripts
/scripts/*
!/scripts/update_data.py
!/scripts/splice_hk9988.py
!/scripts/build_regimes.py
!/scripts/build_payloads.py
!/scripts/build_dashboard.py
!/scripts/combo_v2.py
!/scripts/build_v11.py
!/scripts/build_boards.py
!/scripts/refresh_v13_all.py
!/scripts/rebuild_daily.py
!/scripts/configs.py
!/scripts/decode.py
!/scripts/cycle_feats.py
!/scripts/ma_family.py
!/scripts/final_config.py
!/scripts/raw_signed.py
!/scripts/rescore.py
!/scripts/v11_metrics.py
!/scripts/vm_calibrate.py

!/dashboard
/dashboard/*
!/dashboard/dashboard_template_prod.html
!/dashboard/index.html
!/dashboard/monitor2.html
!/dashboard/us.html
!/dashboard/hk.html
!/dashboard/commodity.html

!/data
/data/*
!/data/*.csv
!/data/JM_history.xlsx

# Fitted JumpModel cache for the v11/v16 pipeline (scaler+model+lambda per
# market-year, keyed on the training data itself). Committed so CI only ever
# does warm inference; a new fit is expected only at the January rollover.
!/fitcache
/fitcache/*
!/fitcache/*.pkl
!/fitcache/*.json

!/results
/results/*
!/results/.gitkeep
!/results/*.csv
!/results/*.json

# Cached per-market/stage/year fitted models (scaler + JumpModel + lambda) -
# committed so daily runs only need online inference, never a historical
# refit. One file per (market, stage, year); the set grows by ~22 files/year
# (11 markets x 2 stages) as new years complete.
!/models
/models/*
!/models/*.joblib
!/models/.gitkeep

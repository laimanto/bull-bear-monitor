# Whitelist: ONLY the Bull-Bear Monitor v6 pipeline is published.
# Research scripts, experiment docs, private notes and scratch data stay local.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/.github

!/scripts
/scripts/*
!/scripts/update_data.py
!/scripts/build_regimes.py
!/scripts/build_payloads.py
!/scripts/build_dashboard.py
!/scripts/combo_v2.py
!/scripts/build_regimes_v7.py

!/dashboard
/dashboard/*
!/dashboard/dashboard_template_prod.html
!/dashboard/index.html
!/dashboard/monitor2.html
!/dashboard/index_v7.html
!/dashboard/monitor2_v7.html

!/data
/data/*
!/data/ndx.csv
!/data/gspc.csv
!/data/hsi.csv
!/data/hscei.csv
!/data/ks11.csv
!/data/nikkei.csv
!/data/ftse.csv
!/data/gold.csv
!/data/arkq.csv
!/data/msft.csv
!/data/nvda.csv
!/data/irx.csv
!/data/JM_history.xlsx

!/results
/results/*
!/results/.gitkeep
!/results/*.csv
!/results/*.json

# Cached per-market/stage/year fitted models (scaler + JumpModel + lambda) -
# committed so daily runs only need online inference, never a historical
# refit. One file per (market, stage, year); the set grows by ~22 files/year
# (11 markets x 2 stages) as new years complete.
!/models
/models/*
!/models/*.joblib
!/models/.gitkeep
